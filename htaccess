Options -Indexes -MultiViews
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteRule ^(database|includes|config|cron|bin|docs|storage|\.git|\.vscode)(/|$) - [R=404,L]
RewriteRule (^|/)\.(?!well-known) - [R=404,L]
RewriteRule \.(sql|bak|orig|old|swp|log|ini|sh|md|lock|env|ya?ml|zip|gz|tar|7z|example|flag)$ - [R=404,NC,L]
RewriteRule ^composer\.(json|lock)$ - [R=404,L]

RewriteRule ^uploads/.*\.(php|phtml|phar|php[0-9])$ - [R=404,NC,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
</IfModule>
